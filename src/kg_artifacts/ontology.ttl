@prefix aib: <http://example.org/ai-news/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

aib:AICompany a owl:Class ;
    rdfs:label "AICompany" ;
    rdfs:comment "An organization that develops AI products" ;
    rdfs:subClassOf aib:Organization .

aib:AIProduct a owl:Class ;
    rdfs:label "AIProduct" ;
    rdfs:comment "An AI-powered product or service" ;
    rdfs:subClassOf aib:Product .

aib:Country a owl:Class ;
    rdfs:label "Country" ;
    rdfs:comment "A country" ;
    rdfs:subClassOf aib:Location .

aib:NationalGroup a owl:Class ;
    rdfs:label "NationalGroup" ;
    rdfs:comment "A national, religious, or political group" .

aib:TechCompany a owl:Class ;
    rdfs:label "TechCompany" ;
    rdfs:comment "A technology company" ;
    rdfs:subClassOf aib:Organization .

aib:developedBy a owl:ObjectProperty ;
    rdfs:label "developedBy" ;
    rdfs:comment "Developed by an organization" ;
    rdfs:domain aib:Product ;
    rdfs:range aib:Organization .

aib:develops a owl:ObjectProperty ;
    rdfs:label "develops" ;
    rdfs:comment "Organization develops a product" ;
    rdfs:domain aib:Organization ;
    rdfs:range aib:Product .

aib:employeeCount a owl:DatatypeProperty ;
    rdfs:label "employeeCount" ;
    rdfs:comment "Number of employees" ;
    rdfs:domain aib:Organization ;
    rdfs:range xsd:integer .

aib:foundedBy a owl:ObjectProperty ;
    rdfs:label "foundedBy" ;
    rdfs:comment "Founded by a person" ;
    rdfs:domain aib:Organization ;
    rdfs:range aib:Person .

aib:foundedYear a owl:DatatypeProperty ;
    rdfs:label "foundedYear" ;
    rdfs:comment "Year the organization was founded" ;
    rdfs:domain aib:Organization ;
    rdfs:range xsd:gYear .

aib:headquarteredIn a owl:ObjectProperty ;
    rdfs:label "headquarteredIn" ;
    rdfs:comment "Headquarters location" ;
    rdfs:domain aib:Organization ;
    rdfs:range aib:Location .

aib:investedIn a owl:ObjectProperty ;
    rdfs:label "investedIn" ;
    rdfs:comment "Investment relationship" ;
    rdfs:domain aib:Organization ;
    rdfs:range aib:Organization .

aib:locatedIn a owl:ObjectProperty ;
    rdfs:label "locatedIn" ;
    rdfs:comment "Event location" ;
    rdfs:domain aib:Event ;
    rdfs:range aib:Location .

aib:relatedTo a owl:ObjectProperty ;
    rdfs:label "relatedTo" ;
    rdfs:comment "Generic relation between entities" .

aib:revenue a owl:DatatypeProperty ;
    rdfs:label "revenue" ;
    rdfs:comment "Revenue amount" ;
    rdfs:domain aib:Organization ;
    rdfs:range xsd:decimal .

aib:uses a owl:ObjectProperty ;
    rdfs:label "uses" ;
    rdfs:comment "Organization uses a technology" ;
    rdfs:domain aib:Organization ;
    rdfs:range aib:Technology .

aib:worksFor a owl:ObjectProperty ;
    rdfs:label "worksFor" ;
    rdfs:comment "Person works for organization" ;
    rdfs:domain aib:Person ;
    rdfs:range aib:Organization .

aib:Event a owl:Class ;
    rdfs:label "Event" ;
    rdfs:comment "A notable event" .

aib:Technology a owl:Class ;
    rdfs:label "Technology" ;
    rdfs:comment "A technology or technique" .

aib:Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:comment "A person mentioned in AI news" .

aib:Location a owl:Class ;
    rdfs:label "Location" ;
    rdfs:comment "A geographic location" .

aib:Product a owl:Class ;
    rdfs:label "Product" ;
    rdfs:comment "A product or service" .

aib:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "An organization or company" .

